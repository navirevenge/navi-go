# Copy to .env and edit. Never commit .env.
POSTGRES_DB=navigo
POSTGRES_USER=navigo
POSTGRES_PASSWORD=change-me

# Must be at least 32 bytes. Generate with: openssl rand -base64 48
NAVIGO_JWT_SECRET=
NAVIGO_JWT_TTL=12h

# Comma-separated browser origins allowed to call the API
NAVIGO_CORS_ORIGINS=http://localhost:3000

# Baked into the frontend at build time
NEXT_PUBLIC_API_URL=http://localhost:8080
