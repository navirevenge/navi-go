#!/bin/sh
# Enforces the navi-revenge-<issue-number> tag on every commit subject.
# Enable with: git config core.hooksPath .githooks

subject=$(head -n 1 "$1")

# Merge commits are generated by git; their branch commits are checked instead.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

if printf '%s\n' "$subject" | grep -Eq '^(fixup! |squash! )?navi-revenge-[0-9]+: .+'; then
  exit 0
fi

cat >&2 <<EOF
Commit rejected: subject must start with navi-revenge-<issue-number>: <summary>
  Example: navi-revenge-12: add vocabulary list endpoint
  Got:     $subject
EOF
exit 1
