meta {
  name: Login with bad password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrong-password"
  }
}

tests {
  test("returns 401", function () {
    expect(res.status).to.equal(401);
  });
}
