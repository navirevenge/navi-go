meta {
  name: Me
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the logged-in user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getEnvVar("email"));
  });
}
